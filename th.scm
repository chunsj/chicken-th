  (define (short-tensor-get2d t i0 i1)
    (short-rank-check 'short-tensor-get2d t 2)
    (short-range-check 'short-tensor-get2d t i0 (THShortTensor_size t 0))
    (short-range-check 'short-tensor-get2d t i1 (THShortTensor_size t 1))
    (THShortTensor_get2d t i0 i1))
  (define (short-tensor-get3d t i0 i1 i2)
    (short-rank-check 'short-tensor-get3d t 3)
    (short-range-check 'short-tensor-get3d t i0 (THShortTensor_size t 0))
    (short-range-check 'short-tensor-get3d t i1 (THShortTensor_size t 1))
    (short-range-check 'short-tensor-get3d t i2 (THShortTensor_size t 2))
    (THShortTensor_get3d t i0 i1 i2))
  (define (short-tensor-get4d t i0 i1 i2 i3)
