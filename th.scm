      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (pointer-s16-ref (pointer+ base (* 2 i))) acc))))))

  (define (list->short-tensor dims ls)
    (let* ((t     (make-short-tensor dims))
           (n     (THShortTensor_nElement t))
           (base  (THShortTensor_data t)))
      (unless (= n (length ls))
        (error 'list->short-tensor "element count mismatch" dims ls))
      (let loop ((i 0) (ls ls))
        (when (pair? ls)
          (pointer-f32-set! (pointer+ base (* 2 i)) (car ls))
          (loop (+ i 1) (cdr ls))))
      t))

