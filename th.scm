  (define (int-tensor->list t)
    (let* ((n     (THIntTensor_nElement t))
           (base  (THIntTensor_data t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (pointer-s32-ref (pointer+ base (* 4 i))) acc))))))

  (define (list->int-tensor dims ls)
    (let* ((t     (make-int-tensor dims))
           (n     (THIntTensor_nElement t))
           (base  (THIntTensor_data t)))
