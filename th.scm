;;;; th - CHICKEN bindings to the PyTorch TH tensor C library.
;;;;
;;;; One module, seven tensor element types (float, double, byte, char,
;;;; short, int, long) plus a TH random-number generator.  Ranks 1..4
;;;; element access plus row-major list <-> tensor conversions is provided
;;;; for every type.
;;;;
;;;; Every tensor/generator handle returned by this module is registered
;;;; with set-finalizer! so the C storage is reclaimed on GC.  All
;;;; dimension/index/shape checks raise Scheme conditions (via error)
;;;; instead of reaching TH's abort handler.

(module th
  (;; ---- exported bindings
  ;; ---- construction ----------------------------------------------
   make-float-tensor make-double-tensor make-byte-tensor make-char-tensor make-short-tensor make-int-tensor make-long-tensor
   float-tensor-clone double-tensor-clone byte-tensor-clone char-tensor-clone short-tensor-clone int-tensor-clone long-tensor-clone
  ;; ---- shape / metadata ----------------------------------------------
   float-tensor-dim float-tensor-size float-tensor-stride float-tensor-dims float-tensor-strides float-tensor-numel float-tensor-contiguous? float-tensor-data double-tensor-dim double-tensor-size double-tensor-stride double-tensor-dims double-tensor-strides double-tensor-numel double-tensor-contiguous? double-tensor-data byte-tensor-dim byte-tensor-size byte-tensor-stride byte-tensor-dims byte-tensor-strides byte-tensor-numel byte-tensor-contiguous? byte-tensor-data char-tensor-dim char-tensor-size char-tensor-stride char-tensor-dims char-tensor-strides char-tensor-numel char-tensor-contiguous? char-tensor-data short-tensor-dim short-tensor-size short-tensor-stride short-tensor-dims short-tensor-strides short-tensor-numel short-tensor-contiguous? short-tensor-data int-tensor-dim int-tensor-size int-tensor-stride int-tensor-dims int-tensor-strides int-tensor-numel int-tensor-contiguous? int-tensor-data long-tensor-dim long-tensor-size long-tensor-stride long-tensor-dims long-tensor-strides long-tensor-numel long-tensor-contiguous? long-tensor-data
  ;; ---- element access ----------------------------------------------
   float-tensor-ref float-tensor-set! float-tensor-get1d float-tensor-get2d float-tensor-get3d float-tensor-get4d float-tensor-set1d! float-tensor-set2d! float-tensor-set3d! float-tensor-set4d! double-tensor-ref double-tensor-set! double-tensor-get1d double-tensor-get2d double-tensor-get3d double-tensor-get4d double-tensor-set1d! double-tensor-set2d! double-tensor-set3d! double-tensor-set4d! byte-tensor-ref byte-tensor-set! byte-tensor-get1d byte-tensor-get2d byte-tensor-get3d byte-tensor-get4d byte-tensor-set1d! byte-tensor-set2d! byte-tensor-set3d! byte-tensor-set4d! char-tensor-ref char-tensor-set! char-tensor-get1d char-tensor-get2d char-tensor-get3d char-tensor-get4d char-tensor-set1d! char-tensor-set2d! char-tensor-set3d! char-tensor-set4d! short-tensor-ref short-tensor-set! short-tensor-get1d short-tensor-get2d short-tensor-get3d short-tensor-get4d short-tensor-set1d! short-tensor-set2d! short-tensor-set3d! short-tensor-set4d! int-tensor-ref int-tensor-set! int-tensor-get1d int-tensor-get2d int-tensor-get3d int-tensor-get4d int-tensor-set1d! int-tensor-set2d! int-tensor-set3d! int-tensor-set4d! long-tensor-ref long-tensor-set! long-tensor-get1d long-tensor-get2d long-tensor-get3d long-tensor-get4d long-tensor-set1d! long-tensor-set2d! long-tensor-set3d! long-tensor-set4d!
  ;; ---- conversions ----------------------------------------------
   float-tensor->list double-tensor->list byte-tensor->list char-tensor->list short-tensor->list int-tensor->list long-tensor->list
   list->float-tensor list->double-tensor list->byte-tensor list->char-tensor list->short-tensor list->int-tensor list->long-tensor
  ;; ---- fill / elementwise in-place ops ----------------------------------------------
   float-tensor-fill! float-tensor-zero! float-tensor-add! float-tensor-mul! float-tensor-div! float-tensor-neg! float-tensor-cinv! float-tensor-sign! float-tensor-cadd! float-tensor-cmul! float-tensor-cdiv! float-tensor-cpow! float-tensor-copy! float-tensor-abs! float-tensor-pow! float-tensor-sqrt! double-tensor-fill! double-tensor-zero! double-tensor-add! double-tensor-mul! double-tensor-div! double-tensor-neg! double-tensor-cinv! double-tensor-sign! double-tensor-cadd! double-tensor-cmul! double-tensor-cdiv! double-tensor-cpow! double-tensor-copy! double-tensor-abs! double-tensor-pow! double-tensor-sqrt! byte-tensor-fill! byte-tensor-zero! byte-tensor-add! byte-tensor-mul! byte-tensor-div! byte-tensor-neg! byte-tensor-cinv! byte-tensor-sign! byte-tensor-cadd! byte-tensor-cmul! byte-tensor-cdiv! byte-tensor-cpow! byte-tensor-copy! char-tensor-fill! char-tensor-zero! char-tensor-add! char-tensor-mul! char-tensor-div! char-tensor-neg! char-tensor-cinv! char-tensor-sign! char-tensor-cadd! char-tensor-cmul! char-tensor-cdiv! char-tensor-cpow! char-tensor-copy! short-tensor-fill! short-tensor-zero! short-tensor-add! short-tensor-mul! short-tensor-div! short-tensor-neg! short-tensor-cinv! short-tensor-sign! short-tensor-cadd! short-tensor-cmul! short-tensor-cdiv! short-tensor-cpow! short-tensor-copy! short-tensor-abs! int-tensor-fill! int-tensor-zero! int-tensor-add! int-tensor-mul! int-tensor-div! int-tensor-neg! int-tensor-cinv! int-tensor-sign! int-tensor-cadd! int-tensor-cmul! int-tensor-cdiv! int-tensor-cpow! int-tensor-copy! int-tensor-abs! long-tensor-fill! long-tensor-zero! long-tensor-add! long-tensor-mul! long-tensor-div! long-tensor-neg! long-tensor-cinv! long-tensor-sign! long-tensor-cadd! long-tensor-cmul! long-tensor-cdiv! long-tensor-cpow! long-tensor-copy! long-tensor-abs!
  ;; ---- reductions / linear algebra ----------------------------------------------
   float-tensor-sum float-tensor-min float-tensor-max float-tensor-median float-tensor-dot float-tensor-mean float-tensor-var float-tensor-std float-tensor-norm double-tensor-sum double-tensor-min double-tensor-max double-tensor-median double-tensor-dot double-tensor-mean double-tensor-var double-tensor-std double-tensor-norm byte-tensor-sum byte-tensor-min byte-tensor-max byte-tensor-median byte-tensor-dot char-tensor-sum char-tensor-min char-tensor-max char-tensor-median char-tensor-dot short-tensor-sum short-tensor-min short-tensor-max short-tensor-median short-tensor-dot int-tensor-sum int-tensor-min int-tensor-max int-tensor-median int-tensor-dot long-tensor-sum long-tensor-min long-tensor-max long-tensor-median long-tensor-dot
   float-tensor-mm float-tensor-addmm! double-tensor-mm double-tensor-addmm! byte-tensor-mm byte-tensor-addmm! char-tensor-mm char-tensor-addmm! short-tensor-mm short-tensor-addmm! int-tensor-mm int-tensor-addmm! long-tensor-mm long-tensor-addmm!
  ;; ---- random number generator ----------------------------------------------
   make-generator
   generator-valid?
   generator-random
   generator-seed!
   generator-manual-seed!
   generator-initial-seed
   generator-uniform
   generator-normal
  ;; ---- random tensor fills ----------------------------------------------
   float-tensor-random! float-tensor-rand! float-tensor-randn! float-tensor-uniform! float-tensor-normal! float-tensor-exponential! float-tensor-bernoulli! float-tensor-geometric! float-tensor-poisson! float-tensor-cauchy! double-tensor-random! double-tensor-rand! double-tensor-randn! double-tensor-uniform! double-tensor-normal! double-tensor-exponential! double-tensor-bernoulli! double-tensor-geometric! double-tensor-poisson! double-tensor-cauchy! byte-tensor-random! byte-tensor-bernoulli! byte-tensor-geometric! byte-tensor-poisson! char-tensor-random! char-tensor-bernoulli! char-tensor-geometric! char-tensor-poisson! short-tensor-random! short-tensor-bernoulli! short-tensor-geometric! short-tensor-poisson! int-tensor-random! int-tensor-bernoulli! int-tensor-geometric! int-tensor-poisson! long-tensor-random! long-tensor-bernoulli! long-tensor-geometric! long-tensor-poisson!
   )
  (import (scheme)
          (chicken base)
          (chicken foreign)
          (chicken memory)
          (chicken type)
          (chicken gc))

  ;; ---- long-storage + generator C hooks ------------------------------
  (foreign-declare "#include <TH.h>")
  (define THGenerator_new (foreign-lambda c-pointer "THGenerator_new"))
  (define THGenerator_free (foreign-lambda void "THGenerator_free" c-pointer))
  (define THGenerator_isValid (foreign-lambda bool "THGenerator_isValid" c-pointer))
  (define THRandom_random (foreign-lambda long "THRandom_random" c-pointer))
  (define THRandom_seed (foreign-lambda void "THRandom_seed" c-pointer))
  (define THRandom_manualSeed (foreign-lambda void "THRandom_manualSeed" c-pointer unsigned-long))
  (define THRandom_initialSeed (foreign-lambda unsigned-long "THRandom_initialSeed" c-pointer))
  (define THRandom_uniform (foreign-lambda double "THRandom_uniform" c-pointer double double))
  (define THRandom_normal (foreign-lambda double "THRandom_normal" c-pointer double double))

  ;; ---- random number generator ----------------------------------------
  (define (gc-guard ptr free)
    (set-finalizer! ptr (lambda (p) (free p)))
    ptr)
  (define (make-generator) (gc-guard (THGenerator_new) THGenerator_free))
  (define (generator-valid? g) (THGenerator_isValid g))
  (define (generator-random g) (THRandom_random g))
  (define (generator-seed! g) (THRandom_seed g))
  (define (generator-manual-seed! g n) (THRandom_manualSeed g n))
  (define (generator-initial-seed g) (THRandom_initialSeed g))
  (define (generator-uniform g a b) (THRandom_uniform g a b))
  (define (generator-normal g m s) (THRandom_normal g m s))

  ;; ------------------------------------------------------------------

  ;; ------------------------------------------------------------------
  ;; FLOAT tensors
  ;; ------------------------------------------------------------------

  ;; ---- TH C hooks ------------------------------------------------------
  (define THFloatTensor_newWithSize (foreign-lambda c-pointer "THFloatTensor_newWithSize" c-pointer c-pointer))
  (define THFloatTensor_newWithSize1d (foreign-lambda c-pointer "THFloatTensor_newWithSize1d" long))
  (define THFloatTensor_newWithSize2d (foreign-lambda c-pointer "THFloatTensor_newWithSize2d" long long))
  (define THFloatTensor_newWithSize3d (foreign-lambda c-pointer "THFloatTensor_newWithSize3d" long long long))
  (define THFloatTensor_newWithSize4d (foreign-lambda c-pointer "THFloatTensor_newWithSize4d" long long long long))
  (define THFloatTensor_newClone (foreign-lambda c-pointer "THFloatTensor_newClone" c-pointer))
  (define THFloatTensor_nDimension (foreign-lambda long "THFloatTensor_nDimension" c-pointer))
  (define THFloatTensor_size (foreign-lambda long "THFloatTensor_size" c-pointer long))
  (define THFloatTensor_stride (foreign-lambda long "THFloatTensor_stride" c-pointer long))
  (define THFloatTensor_nElement (foreign-lambda long "THFloatTensor_nElement" c-pointer))
  (define THFloatTensor_isContiguous (foreign-lambda bool "THFloatTensor_isContiguous" c-pointer))
  (define THFloatTensor_data (foreign-lambda c-pointer "THFloatTensor_data" c-pointer))
  (define THFloatTensor_get1d (foreign-lambda float "THFloatTensor_get1d" c-pointer long))
  (define THFloatTensor_get2d (foreign-lambda float "THFloatTensor_get2d" c-pointer long long))
  (define THFloatTensor_get3d (foreign-lambda float "THFloatTensor_get3d" c-pointer long long long))
  (define THFloatTensor_get4d (foreign-lambda float "THFloatTensor_get4d" c-pointer long long long long))
  (define THFloatTensor_set1d (foreign-lambda void "THFloatTensor_set1d" c-pointer long float))
  (define THFloatTensor_set2d (foreign-lambda void "THFloatTensor_set2d" c-pointer long long float))
  (define THFloatTensor_set3d (foreign-lambda void "THFloatTensor_set3d" c-pointer long long long float))
  (define THFloatTensor_set4d (foreign-lambda void "THFloatTensor_set4d" c-pointer long long long long float))
  (define THFloatTensor_fill (foreign-lambda void "THFloatTensor_fill" c-pointer float))
  (define THFloatTensor_zero (foreign-lambda void "THFloatTensor_zero" c-pointer))
  (define THFloatTensor_add (foreign-lambda void "THFloatTensor_add" c-pointer c-pointer float))
  (define THFloatTensor_mul (foreign-lambda void "THFloatTensor_mul" c-pointer c-pointer float))
  (define THFloatTensor_div (foreign-lambda void "THFloatTensor_div" c-pointer c-pointer float))
  (define THFloatTensor_pow (foreign-lambda void "THFloatTensor_pow" c-pointer c-pointer float))
  (define THFloatTensor_neg (foreign-lambda void "THFloatTensor_neg" c-pointer c-pointer))
  (define THFloatTensor_cinv (foreign-lambda void "THFloatTensor_cinv" c-pointer c-pointer))
  (define THFloatTensor_abs (foreign-lambda void "THFloatTensor_abs" c-pointer c-pointer))
  (define THFloatTensor_sign (foreign-lambda void "THFloatTensor_sign" c-pointer c-pointer))
  (define THFloatTensor_sqrt (foreign-lambda void "THFloatTensor_sqrt" c-pointer c-pointer))
  (define THFloatTensor_cadd (foreign-lambda void "THFloatTensor_cadd" c-pointer c-pointer float c-pointer))
  (define THFloatTensor_cmul (foreign-lambda void "THFloatTensor_cmul" c-pointer c-pointer c-pointer))
  (define THFloatTensor_cdiv (foreign-lambda void "THFloatTensor_cdiv" c-pointer c-pointer c-pointer))
  (define THFloatTensor_cpow (foreign-lambda void "THFloatTensor_cpow" c-pointer c-pointer c-pointer))
  (define THFloatTensor_copy (foreign-lambda void "THFloatTensor_copy" c-pointer c-pointer))
  (define THFloatTensor_sumall (foreign-lambda double "THFloatTensor_sumall" c-pointer))
  (define THFloatTensor_meanall (foreign-lambda double "THFloatTensor_meanall" c-pointer))
  (define THFloatTensor_varall (foreign-lambda double "THFloatTensor_varall" c-pointer int))
  (define THFloatTensor_stdall (foreign-lambda double "THFloatTensor_stdall" c-pointer int))
  (define THFloatTensor_normall (foreign-lambda double "THFloatTensor_normall" c-pointer float))
  (define THFloatTensor_minall (foreign-lambda float "THFloatTensor_minall" c-pointer))
  (define THFloatTensor_maxall (foreign-lambda float "THFloatTensor_maxall" c-pointer))
  (define THFloatTensor_medianall (foreign-lambda float "THFloatTensor_medianall" c-pointer))
  (define THFloatTensor_dot (foreign-lambda double "THFloatTensor_dot" c-pointer c-pointer))
  (define THFloatTensor_addmm (foreign-lambda void "THFloatTensor_addmm" c-pointer float c-pointer float c-pointer c-pointer))
  (define THFloatTensor_random (foreign-lambda void "THFloatTensor_random" c-pointer c-pointer))
  (define THFloatTensor_uniform (foreign-lambda void "THFloatTensor_uniform" c-pointer c-pointer double double))
  (define THFloatTensor_normal (foreign-lambda void "THFloatTensor_normal" c-pointer c-pointer double double))
  (define THFloatTensor_exponential (foreign-lambda void "THFloatTensor_exponential" c-pointer c-pointer double))
  (define THFloatTensor_bernoulli (foreign-lambda void "THFloatTensor_bernoulli" c-pointer c-pointer double))
  (define THFloatTensor_geometric (foreign-lambda void "THFloatTensor_geometric" c-pointer c-pointer double))
  (define THFloatTensor_poisson (foreign-lambda void "THFloatTensor_poisson" c-pointer c-pointer double))
  (define THFloatTensor_cauchy (foreign-lambda void "THFloatTensor_cauchy" c-pointer c-pointer double double))
  (define THFloatTensor_free (foreign-lambda void "THFloatTensor_free" c-pointer))

  ;; ---- shared rank / range / shape checks ------------------------------
  (define (f-rank-check who t n)
    (let ((r (THFloatTensor_nDimension t)))
      (when (not (= r n))
        (error who "tensor must have" n "dimension(s), got" r))))
  (define (f-range-check who t i n)
    (when (or (< i 0) (>= i n))
      (error who "index out of range" i "dim" n)))
  (define (f-same-dims? a b)
    (let ((n (THFloatTensor_nDimension a)))
      (and (= n (THFloatTensor_nDimension b))
           (let loop ((i (- n 1)))
             (or (< i 0)
                 (and (= (THFloatTensor_size a i) (THFloatTensor_size b i))
                      (loop (- i 1))))))))
  (define (f-binop-check who a b)
    (when (not (f-same-dims? a b))
      (error who "tensor shapes differ")))

  ;; ---- construction ----------------------------------------------------
  (define (float-tensor-dim t i)
    (let ((n (THFloatTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'float-tensor-dim "index out of range" i "dim" n))
      (THFloatTensor_size t i)))
  (define (float-tensor-size t i) (float-tensor-dim t i))
  (define (float-tensor-stride t i)
    (let ((n (THFloatTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'float-tensor-stride "index out of range" i "dim" n))
      (THFloatTensor_stride t i)))
  (define (float-tensor-dims t)
    (let ((n (THFloatTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THFloatTensor_size t i) acc))))))
  (define (float-tensor-strides t)
    (let ((n (THFloatTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THFloatTensor_stride t i) acc))))))
  (define (float-tensor-numel t) (THFloatTensor_nElement t))
  (define (float-tensor-contiguous? t) (THFloatTensor_isContiguous t))
  (define (float-tensor-data t) (THFloatTensor_data t))

  (define (make-float-tensor dims)
    (case (length dims)
      ((1) (gc-guard (THFloatTensor_newWithSize1d (car dims)) THFloatTensor_free))
      ((2) (gc-guard (THFloatTensor_newWithSize2d (car dims) (cadr dims)) THFloatTensor_free))
      ((3) (gc-guard (THFloatTensor_newWithSize3d (car dims) (cadr dims) (caddr dims)) THFloatTensor_free))
      ((4) (gc-guard (THFloatTensor_newWithSize4d (car dims) (cadr dims) (caddr dims) (cadddr dims)) THFloatTensor_free))
      (else (error 'make-float-tensor "make-*tensor supports ranks 1..4" dims))))
  (define (float-tensor-clone t) (gc-guard (THFloatTensor_newClone t) THFloatTensor_free))

  ;; ---- element access --------------------------------------------------
  (define (float-tensor-get1d t i)
    (f-rank-check 'float-tensor-get1d t 1)
    (f-range-check 'float-tensor-get1d t i (THFloatTensor_size t 0))
    (THFloatTensor_get1d t i))
  (define (float-tensor-get2d t i0 i1)
    (f-rank-check 'float-tensor-get2d t 2)
    (f-range-check 'float-tensor-get2d t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-get2d t i1 (THFloatTensor_size t 1))
    (THFloatTensor_get2d t i0 i1))
  (define (float-tensor-get3d t i0 i1 i2)
    (f-rank-check 'float-tensor-get3d t 3)
    (f-range-check 'float-tensor-get3d t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-get3d t i1 (THFloatTensor_size t 1))
    (f-range-check 'float-tensor-get3d t i2 (THFloatTensor_size t 2))
    (THFloatTensor_get3d t i0 i1 i2))
  (define (float-tensor-get4d t i0 i1 i2 i3)
    (f-rank-check 'float-tensor-get4d t 4)
    (f-range-check 'float-tensor-get4d t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-get4d t i1 (THFloatTensor_size t 1))
    (f-range-check 'float-tensor-get4d t i2 (THFloatTensor_size t 2))
    (f-range-check 'float-tensor-get4d t i3 (THFloatTensor_size t 3))
    (THFloatTensor_get4d t i0 i1 i2 i3))
  (define (float-tensor-set1d! t i v)
    (f-rank-check 'float-tensor-set1d! t 1)
    (f-range-check 'float-tensor-set1d! t i (THFloatTensor_size t 0))
    (THFloatTensor_set1d t i v))
  (define (float-tensor-set2d! t i0 i1 v)
    (f-rank-check 'float-tensor-set2d! t 2)
    (f-range-check 'float-tensor-set2d! t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-set2d! t i1 (THFloatTensor_size t 1))
    (THFloatTensor_set2d t i0 i1 v))
  (define (float-tensor-set3d! t i0 i1 i2 v)
    (f-rank-check 'float-tensor-set3d! t 3)
    (f-range-check 'float-tensor-set3d! t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-set3d! t i1 (THFloatTensor_size t 1))
    (f-range-check 'float-tensor-set3d! t i2 (THFloatTensor_size t 2))
    (THFloatTensor_set3d t i0 i1 i2 v))
  (define (float-tensor-set4d! t i0 i1 i2 i3 v)
    (f-rank-check 'float-tensor-set4d! t 4)
    (f-range-check 'float-tensor-set4d! t i0 (THFloatTensor_size t 0))
    (f-range-check 'float-tensor-set4d! t i1 (THFloatTensor_size t 1))
    (f-range-check 'float-tensor-set4d! t i2 (THFloatTensor_size t 2))
    (f-range-check 'float-tensor-set4d! t i3 (THFloatTensor_size t 3))
    (THFloatTensor_set4d t i0 i1 i2 i3 v))
  (define (float-tensor-ref t . is)
    (let ((n (length is)))
      (f-rank-check 'float-tensor-ref t n)
      (apply (case n ((1) float-tensor-get1d) ((2) float-tensor-get2d)
                     ((3) float-tensor-get3d) ((4) float-tensor-get4d)
                     (else (error 'float-tensor-ref "ref supports ranks 1..4" n)))
             t is)))
  (define (float-tensor-set! t v . is)
    (let ((n (length is)))
      (f-rank-check 'float-tensor-set! t n)
      (apply (case n ((1) float-tensor-set1d!) ((2) float-tensor-set2d!)
                     ((3) float-tensor-set3d!) ((4) float-tensor-set4d!)
                     (else (error 'float-tensor-set! "set! supports ranks 1..4" n)))
             t (append is (list v)))))

  ;; ---- fill / elementwise in-place ops --------------------------------
  (define (float-tensor-fill! t v) (THFloatTensor_fill t v))
  (define (float-tensor-zero! t) (THFloatTensor_zero t))
  (define (float-tensor-add! t v) (THFloatTensor_add t t v))
  (define (float-tensor-mul! t v) (THFloatTensor_mul t t v))
  (define (float-tensor-div! t v) (THFloatTensor_div t t v))
  (define (float-tensor-pow! t v) (THFloatTensor_pow t t v))
  (define (float-tensor-neg! t) (THFloatTensor_neg t t))
  (define (float-tensor-cinv! t) (THFloatTensor_cinv t t))
  (define (float-tensor-abs! t) (THFloatTensor_abs t t))
  (define (float-tensor-sign! t) (THFloatTensor_sign t t))
  (define (float-tensor-sqrt! t) (THFloatTensor_sqrt t t))
  (define (float-tensor-cadd! t v u)
    (f-binop-check 'float-tensor-cadd! t u)
    (THFloatTensor_cadd t t v u))
  (define (float-tensor-cmul! t v u)
    (f-binop-check 'float-tensor-cmul! t u)
    (THFloatTensor_cmul t t u))
  (define (float-tensor-cdiv! t v u)
    (f-binop-check 'float-tensor-cdiv! t u)
    (THFloatTensor_cdiv t t u))
  (define (float-tensor-cpow! t v u)
    (f-binop-check 'float-tensor-cpow! t u)
    (THFloatTensor_cpow t t u))
  (define (float-tensor-copy! t src)
    (when (not (= (THFloatTensor_nElement t) (THFloatTensor_nElement src)))
      (error 'float-tensor-copy! "tensors must have the same number of elements"
             (THFloatTensor_nElement t) (THFloatTensor_nElement src)))
    (THFloatTensor_copy t src))

  ;; ---- reductions ------------------------------------------------------
  (define (float-tensor-sum t) (THFloatTensor_sumall t))
  (define (float-tensor-mean t) (THFloatTensor_meanall t))
  (define (float-tensor-var t b) (THFloatTensor_varall t b))
  (define (float-tensor-std t b) (THFloatTensor_stdall t b))
  (define (float-tensor-norm t p) (THFloatTensor_normall t p))
  (define (float-tensor-min t) (THFloatTensor_minall t))
  (define (float-tensor-max t) (THFloatTensor_maxall t))
  (define (float-tensor-median t) (THFloatTensor_medianall t))
  (define (float-tensor-dot t u)
    (f-binop-check 'float-tensor-dot t u)
    (THFloatTensor_dot t u))

  ;; ---- linear algebra --------------------------------------------------
  (define (float-tensor-addmm! r beta t alpha a b)
    (f-rank-check 'float-tensor-addmm! r 2)
    (f-rank-check 'float-tensor-addmm! a 2)
    (f-rank-check 'float-tensor-addmm! b 2)
    (THFloatTensor_addmm r beta t alpha a b))
  (define (float-tensor-mm a b)
    (let ((r (make-float-tensor (list (THFloatTensor_size a 0) (THFloatTensor_size b 1)))))
      (float-tensor-addmm! r 0.0 r 1.0 a b)
      r))

  ;; ------------------------------------------------------------------
  ;; DOUBLE tensors
  ;; ------------------------------------------------------------------

  ;; ------------------------------------------------------------------

  ;; ------------------------------------------------------------------
  ;; FLOAT tensors
  ;; ------------------------------------------------------------------

  ;; ---- TH C hooks ------------------------------------------------------
  (define THDoubleTensor_newWithSize (foreign-lambda c-pointer "THDoubleTensor_newWithSize" c-pointer c-pointer))
