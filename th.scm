    (short-range-check 'short-tensor-get4d t i0 (THShortTensor_size t 0))
    (short-range-check 'short-tensor-get4d t i1 (THShortTensor_size t 1))
    (short-range-check 'short-tensor-get4d t i2 (THShortTensor_size t 2))
    (short-range-check 'short-tensor-get4d t i3 (THShortTensor_size t 3))
    (THShortTensor_get4d t i0 i1 i2 i3))
