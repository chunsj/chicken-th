  ;; ---- shared rank / range / shape checks ------------------------------
  (define (char-rank-check who t n)
    (let ((r (THCharTensor_nDimension t)))
      (when (not (= r n))
        (error who "tensor must have" n "dimension(s), got" r))))
  (define (char-range-check who t i n)
    (when (or (< i 0) (>= i n))
      (error who "index out of range" i "dim" n)))
  (define (char-same-dims? a b)
    (let ((n (THCharTensor_nDimension a)))
      (and (= n (THCharTensor_nDimension b))
           (let loop ((i (- n 1)))
             (or (< i 0)
                 (and (= (THCharTensor_size a i) (THCharTensor_size b i))
                      (loop (- i 1))))))))
  (define (char-binop-check who a b)
    (when (not (char-same-dims? a b))
      (error who "tensor shapes differ")))

  ;; ---- construction ----------------------------------------------------
  (define (char-tensor-dim t i)
    (let ((n (THCharTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'char-tensor-dim "index out of range" i "dim" n))
      (THCharTensor_size t i)))
  (define (char-tensor-size t i) (char-tensor-dim t i))
  (define (char-tensor-stride t i)
    (let ((n (THCharTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'char-tensor-stride "index out of range" i "dim" n))
      (THCharTensor_stride t i)))
  (define (char-tensor-dims t)
    (let ((n (THCharTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THCharTensor_size t i) acc))))))
  (define (char-tensor-strides t)
    (let ((n (THCharTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THCharTensor_stride t i) acc))))))
  (define (char-tensor-numel t) (THCharTensor_nElement t))
  (define (char-tensor-contiguous? t) (THCharTensor_isContiguous t))
  (define (char-tensor-data t) (THCharTensor_data t))

  (define (make-char-tensor dims)
    (case (length dims)
      ((1) (gc-guard (THCharTensor_newWithSize1d (car dims)) THCharTensor_free))
      ((2) (gc-guard (THCharTensor_newWithSize2d (car dims) (cadr dims)) THCharTensor_free))
      ((3) (gc-guard (THCharTensor_newWithSize3d (car dims) (cadr dims) (caddr dims)) THCharTensor_free))
      ((4) (gc-guard (THCharTensor_newWithSize4d (car dims) (cadr dims) (caddr dims) (cadddr dims)) THCharTensor_free))
      (else (error 'make-char-tensor "make-*tensor supports ranks 1..4" dims))))
  (define (char-tensor-clone t) (gc-guard (THCharTensor_newClone t) THCharTensor_free))

