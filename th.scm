    (short-range-check 'short-tensor-set3d! t i0 (THShortTensor_size t 0))
    (short-range-check 'short-tensor-set3d! t i1 (THShortTensor_size t 1))
    (short-range-check 'short-tensor-set3d! t i2 (THShortTensor_size t 2))
    (THShortTensor_set3d t i0 i1 i2 v))
  (define (short-tensor-set4d! t i0 i1 i2 i3 v)
    (short-rank-check 'short-tensor-set4d! t 4)
    (short-range-check 'short-tensor-set4d! t i0 (THShortTensor_size t 0))
    (short-range-check 'short-tensor-set4d! t i1 (THShortTensor_size t 1))
    (short-range-check 'short-tensor-set4d! t i2 (THShortTensor_size t 2))
    (short-range-check 'short-tensor-set4d! t i3 (THShortTensor_size t 3))
    (THShortTensor_set4d t i0 i1 i2 i3 v))
  (define (short-tensor-ref t . is)
    (let ((n (length is)))
      (short-rank-check 'short-tensor-ref t n)
      (apply (case n ((1) short-tensor-get1d) ((2) short-tensor-get2d)
                     ((3) short-tensor-get3d) ((4) short-tensor-get4d)
                     (else (error 'short-tensor-ref "ref supports ranks 1..4" n)))
             t is)))
  (define (short-tensor-set! t v . is)
    (let ((n (length is)))
      (short-rank-check 'short-tensor-set! t n)
      (apply (case n ((1) short-tensor-set1d!) ((2) short-tensor-set2d!)
                     ((3) short-tensor-set3d!) ((4) short-tensor-set4d!)
                     (else (error 'short-tensor-set! "set! supports ranks 1..4" n)))
             t (append is (list v)))))

  ;; ---- fill / elementwise in-place ops --------------------------------
  (define (short-tensor-fill! t v) (THShortTensor_fill t v))
  (define (short-tensor-zero! t) (THShortTensor_zero t))
  (define (short-tensor-add! t v) (THShortTensor_add t t v))
