  ;; ---- shared rank / range / shape checks ------------------------------
  (define (short-rank-check who t n)
    (let ((r (THShortTensor_nDimension t)))
      (when (not (= r n))
        (error who "tensor must have" n "dimension(s), got" r))))
  (define (short-range-check who t i n)
    (when (or (< i 0) (>= i n))
      (error who "index out of range" i "dim" n)))
  (define (short-same-dims? a b)
    (let ((n (THShortTensor_nDimension a)))
      (and (= n (THShortTensor_nDimension b))
           (let loop ((i (- n 1)))
             (or (< i 0)
                 (and (= (THShortTensor_size a i) (THShortTensor_size b i))
                      (loop (- i 1))))))))
  (define (short-binop-check who a b)
    (when (not (short-same-dims? a b))
      (error who "tensor shapes differ")))

  ;; ---- construction ----------------------------------------------------
  (define (short-tensor-dim t i)
    (let ((n (THShortTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'short-tensor-dim "index out of range" i "dim" n))
      (THShortTensor_size t i)))
  (define (short-tensor-size t i) (short-tensor-dim t i))
  (define (short-tensor-stride t i)
    (let ((n (THShortTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'short-tensor-stride "index out of range" i "dim" n))
      (THShortTensor_stride t i)))
  (define (short-tensor-dims t)
    (let ((n (THShortTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THShortTensor_size t i) acc))))))
  (define (short-tensor-strides t)
    (let ((n (THShortTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THShortTensor_stride t i) acc))))))
  (define (short-tensor-numel t) (THShortTensor_nElement t))
  (define (short-tensor-contiguous? t) (THShortTensor_isContiguous t))
  (define (short-tensor-data t) (THShortTensor_data t))

  (define (make-short-tensor dims)
    (case (length dims)
      ((1) (gc-guard (THShortTensor_newWithSize1d (car dims)) THShortTensor_free))
      ((2) (gc-guard (THShortTensor_newWithSize2d (car dims) (cadr dims)) THShortTensor_free))
      ((3) (gc-guard (THShortTensor_newWithSize3d (car dims) (cadr dims) (caddr dims)) THShortTensor_free))
      ((4) (gc-guard (THShortTensor_newWithSize4d (car dims) (cadr dims) (caddr dims) (cadddr dims)) THShortTensor_free))
      (else (error 'make-short-tensor "make-*tensor supports ranks 1..4" dims))))
  (define (short-tensor-clone t) (gc-guard (THShortTensor_newClone t) THShortTensor_free))

