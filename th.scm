  ;; ---- shared rank / range / shape checks ------------------------------
  (define (f-rank-check who t n)
    (let ((r (THDoubleTensor_nDimension t)))
      (when (not (= r n))
        (error who "tensor must have" n "dimension(s), got" r))))
  (define (f-range-check who t i n)
    (when (or (< i 0) (>= i n))
      (error who "index out of range" i "dim" n)))
  (define (f-same-dims? a b)
    (let ((n (THDoubleTensor_nDimension a)))
      (and (= n (THDoubleTensor_nDimension b))
           (let loop ((i (- n 1)))
             (or (< i 0)
                 (and (= (THDoubleTensor_size a i) (THDoubleTensor_size b i))
                      (loop (- i 1))))))))
  (define (f-binop-check who a b)
    (when (not (f-same-dims? a b))
      (error who "tensor shapes differ")))

  ;; ---- construction ----------------------------------------------------
  (define (double-tensor-dim t i)
    (let ((n (THDoubleTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'double-tensor-dim "index out of range" i "dim" n))
      (THDoubleTensor_size t i)))
  (define (double-tensor-size t i) (double-tensor-dim t i))
  (define (double-tensor-stride t i)
    (let ((n (THDoubleTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'double-tensor-stride "index out of range" i "dim" n))
      (THDoubleTensor_stride t i)))
  (define (double-tensor-dims t)
    (let ((n (THDoubleTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THDoubleTensor_size t i) acc))))))
  (define (double-tensor-strides t)
    (let ((n (THDoubleTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THDoubleTensor_stride t i) acc))))))
  (define (double-tensor-numel t) (THDoubleTensor_nElement t))
  (define (double-tensor-contiguous? t) (THDoubleTensor_isContiguous t))
  (define (double-tensor-data t) (THDoubleTensor_data t))

  (define (make-double-tensor dims)
    (case (length dims)
      ((1) (gc-guard (THDoubleTensor_newWithSize1d (car dims)) THDoubleTensor_free))
      ((2) (gc-guard (THDoubleTensor_newWithSize2d (car dims) (cadr dims)) THDoubleTensor_free))
      ((3) (gc-guard (THDoubleTensor_newWithSize3d (car dims) (cadr dims) (caddr dims)) THDoubleTensor_free))
      ((4) (gc-guard (THDoubleTensor_newWithSize4d (car dims) (cadr dims) (caddr dims) (cadddr dims)) THDoubleTensor_free))
      (else (error 'make-double-tensor "make-*tensor supports ranks 1..4" dims))))
