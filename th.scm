  ;; ---- shared rank / range / shape checks ------------------------------
  (define (long-rank-check who t n)
    (let ((r (THLongTensor_nDimension t)))
      (when (not (= r n))
        (error who "tensor must have" n "dimension(s), got" r))))
  (define (long-range-check who t i n)
    (when (or (< i 0) (>= i n))
      (error who "index out of range" i "dim" n)))
  (define (long-same-dims? a b)
    (let ((n (THLongTensor_nDimension a)))
      (and (= n (THLongTensor_nDimension b))
           (let loop ((i (- n 1)))
             (or (< i 0)
                 (and (= (THLongTensor_size a i) (THLongTensor_size b i))
                      (loop (- i 1))))))))
  (define (long-binop-check who a b)
    (when (not (long-same-dims? a b))
      (error who "tensor shapes differ")))

  ;; ---- construction ----------------------------------------------------
  (define (long-tensor-dim t i)
    (let ((n (THLongTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'long-tensor-dim "index out of range" i "dim" n))
      (THLongTensor_size t i)))
  (define (long-tensor-size t i) (long-tensor-dim t i))
  (define (long-tensor-stride t i)
    (let ((n (THLongTensor_nDimension t)))
      (when (or (< i 0) (>= i n))
        (error 'long-tensor-stride "index out of range" i "dim" n))
      (THLongTensor_stride t i)))
  (define (long-tensor-dims t)
    (let ((n (THLongTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THLongTensor_size t i) acc))))))
  (define (long-tensor-strides t)
    (let ((n (THLongTensor_nDimension t)))
      (let loop ((i 0) (acc '()))
        (if (= i n)
            (reverse acc)
            (loop (+ i 1) (cons (THLongTensor_stride t i) acc))))))
  (define (long-tensor-numel t) (THLongTensor_nElement t))
  (define (long-tensor-contiguous? t) (THLongTensor_isContiguous t))
  (define (long-tensor-data t) (THLongTensor_data t))

  (define (make-long-tensor dims)
    (case (length dims)
      ((1) (gc-guard (THLongTensor_newWithSize1d (car dims)) THLongTensor_free))
      ((2) (gc-guard (THLongTensor_newWithSize2d (car dims) (cadr dims)) THLongTensor_free))
      ((3) (gc-guard (THLongTensor_newWithSize3d (car dims) (cadr dims) (caddr dims)) THLongTensor_free))
      ((4) (gc-guard (THLongTensor_newWithSize4d (car dims) (cadr dims) (caddr dims) (cadddr dims)) THLongTensor_free))
      (else (error 'make-long-tensor "make-*tensor supports ranks 1..4" dims))))
  (define (long-tensor-clone t) (gc-guard (THLongTensor_newClone t) THLongTensor_free))

  ;; ---- element access --------------------------------------------------
  (define (long-tensor-get1d t i)
    (long-rank-check 'long-tensor-get1d t 1)
    (long-range-check 'long-tensor-get1d t i (THLongTensor_size t 0))
    (THLongTensor_get1d t i))
  (define (long-tensor-get2d t i0 i1)
    (long-rank-check 'long-tensor-get2d t 2)
    (long-range-check 'long-tensor-get2d t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-get2d t i1 (THLongTensor_size t 1))
    (THLongTensor_get2d t i0 i1))
  (define (long-tensor-get3d t i0 i1 i2)
    (long-rank-check 'long-tensor-get3d t 3)
    (long-range-check 'long-tensor-get3d t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-get3d t i1 (THLongTensor_size t 1))
    (long-range-check 'long-tensor-get3d t i2 (THLongTensor_size t 2))
    (THLongTensor_get3d t i0 i1 i2))
  (define (long-tensor-get4d t i0 i1 i2 i3)
    (long-rank-check 'long-tensor-get4d t 4)
    (long-range-check 'long-tensor-get4d t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-get4d t i1 (THLongTensor_size t 1))
    (long-range-check 'long-tensor-get4d t i2 (THLongTensor_size t 2))
    (long-range-check 'long-tensor-get4d t i3 (THLongTensor_size t 3))
    (THLongTensor_get4d t i0 i1 i2 i3))
  (define (long-tensor-set1d! t i v)
    (long-rank-check 'long-tensor-set1d! t 1)
    (long-range-check 'long-tensor-set1d! t i (THLongTensor_size t 0))
    (THLongTensor_set1d t i v))
  (define (long-tensor-set2d! t i0 i1 v)
    (long-rank-check 'long-tensor-set2d! t 2)
    (long-range-check 'long-tensor-set2d! t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-set2d! t i1 (THLongTensor_size t 1))
    (THLongTensor_set2d t i0 i1 v))
  (define (long-tensor-set3d! t i0 i1 i2 v)
    (long-rank-check 'long-tensor-set3d! t 3)
    (long-range-check 'long-tensor-set3d! t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-set3d! t i1 (THLongTensor_size t 1))
    (long-range-check 'long-tensor-set3d! t i2 (THLongTensor_size t 2))
    (THLongTensor_set3d t i0 i1 i2 v))
  (define (long-tensor-set4d! t i0 i1 i2 i3 v)
    (long-rank-check 'long-tensor-set4d! t 4)
    (long-range-check 'long-tensor-set4d! t i0 (THLongTensor_size t 0))
    (long-range-check 'long-tensor-set4d! t i1 (THLongTensor_size t 1))
    (long-range-check 'long-tensor-set4d! t i2 (THLongTensor_size t 2))
    (long-range-check 'long-tensor-set4d! t i3 (THLongTensor_size t 3))
    (THLongTensor_set4d t i0 i1 i2 i3 v))
  (define (long-tensor-ref t . is)
    (let ((n (length is)))
      (long-rank-check 'long-tensor-ref t n)
      (apply (case n ((1) long-tensor-get1d) ((2) long-tensor-get2d)
                     ((3) long-tensor-get3d) ((4) long-tensor-get4d)
                     (else (error 'long-tensor-ref "ref supports ranks 1..4" n)))
             t is)))
  (define (long-tensor-set! t v . is)
    (let ((n (length is)))
      (long-rank-check 'long-tensor-set! t n)
      (apply (case n ((1) long-tensor-set1d!) ((2) long-tensor-set2d!)
                     ((3) long-tensor-set3d!) ((4) long-tensor-set4d!)
                     (else (error 'long-tensor-set! "set! supports ranks 1..4" n)))
             t (append is (list v)))))

